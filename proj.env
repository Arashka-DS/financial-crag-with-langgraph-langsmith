# Routes the OpenAI client to your local free LLM instance via Docker host networking (Use a local LLM in docker)
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_BASE=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama_fake_key

# LangSmith telemetry tracking (Get your API key at smith.langchain.com)
LANGSMITH_API_KEY=lsv2_...
